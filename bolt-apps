#!/bin/sh
# bolt-apps: short launcher for the toolkit from a clone. Finds node, then runs toolkit/bin/bolt-apps.mjs with your arguments.
#   ./bolt-apps new script-template my-tool      (or put this folder on PATH)
here=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || exit 2
# follow a symlink to this file (a copy on PATH)
if [ -L "$0" ]; then
  target=$(readlink "$0"); case "$target" in /*) ;; *) target="$(dirname -- "$0")/$target" ;; esac
  here=$(CDPATH= cd -- "$(dirname -- "$target")" 2>/dev/null && pwd -P) || exit 2
fi
node_bin=$(command -v node 2>/dev/null || command -v nodejs 2>/dev/null)
if [ -z "$node_bin" ]; then
  echo "bolt-apps: Node 18 or newer is needed and was not found. Install it from https://nodejs.org, then run this again." >&2
  exit 127
fi
exec "$node_bin" "$here/toolkit/bin/bolt-apps.mjs" "$@"
