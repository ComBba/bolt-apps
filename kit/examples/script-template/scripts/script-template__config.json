{
  "app": {
    "id": "script-template",
    "chip": "tpl",
    "title": "Script template",
    "icon": "list",
    "description": "A blank script app on the kit: overview, a list with a filter word, a detail view, Back, cache with an old copy, offline row. Replace the API and the fields.",
    "timeout": 20,
    "service": "Example API"
  },
  "api": {
    "base_url": "https://api.example.com",
    "key_env": "TEMPLATE_API_KEY",
    "auth_in": "query",
    "auth_param": "api_key",
    "user_agent": "bolt-app-example/1.0 (script-template)",
    "call_timeout_s": 8,
    "deadline_s": 12,
    "max_bytes": 2000000,
    "fixture_default": false
  },
  "hosts": [
    "api.example.com"
  ],
  "cache": {
    "ttl": 60,
    "stale_max": 86400
  },
  "endpoints": {
    "items": {
      "path": "/v1/items",
      "data": "items"
    }
  },
  "fields": {
    "id": "id",
    "name": "name",
    "status": "status",
    "count": "count"
  },
  "status_badges": {
    "ok": "OK",
    "late": "LATE",
    "down": "DOWN"
  },
  "tiles": {
    "count_label": "Items",
    "late_label": "Late"
  },
  "charts_note": "none: add a chart view by copying the items view and changing its right_widget in emit_yaml()"
}