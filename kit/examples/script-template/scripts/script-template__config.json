{
  "app": {
    "id": "script-template",
    "chip": "script-template",
    "title": "Script template",
    "icon": "Image",
    "description": "Search the Art Institute of Chicago's public-domain artworks, no key: number tiles with meters and sparklines, a list with a big picture in the preview pane, a chart, a table, a picture grid and a detail view. Replace the API and the fields to make it yours.",
    "timeout": 25,
    "service": "Art Institute of Chicago"
  },
  "api": {
    "base_url": "https://api.artic.edu",
    "user_agent": "bolt-app-example/1.0 (script-template)",
    "call_timeout_s": 8,
    "deadline_s": 14,
    "max_bytes": 1000000,
    "fixture_default": false
  },
  "hosts": [
    "api.artic.edu",
    "www.artic.edu"
  ],
  "images": {
    "base_url": "https://www.artic.edu/iiif/2",
    "widths": [
      140,
      110,
      80
    ],
    "max_bytes": 11900,
    "call_timeout_s": 5,
    "budget_s": 8,
    "workers": 4,
    "chunk_chars": 4000,
    "max_chunks": 4,
    "hero": {
      "widths": [
        400,
        250,
        220,
        180,
        140
      ],
      "max_bytes": 70000,
      "chunk_chars": 4000,
      "max_chunks": 24,
      "rows": 8
    }
  },
  "cache": {
    "ttl": 600,
    "stale_max": 86400,
    "thumb_ttl": 2592000,
    "miss_ttl": 900
  },
  "endpoints": {
    "items": {
      "path": "/api/v1/artworks/search",
      "data": "data",
      "limit": 9,
      "default_query": "landscape",
      "search_fields": [
        "title",
        "artist_title",
        "medium_display"
      ],
      "fields": "id,title,artist_display,date_display,date_start,image_id,is_public_domain,medium_display,place_of_origin,department_title",
      "periods": [
        [
          null,
          1600
        ],
        [
          1600,
          1700
        ],
        [
          1700,
          1800
        ],
        [
          1800,
          1850
        ],
        [
          1850,
          1900
        ],
        [
          1900,
          1950
        ],
        [
          1950,
          null
        ]
      ],
      "department_count": 6
    },
    "item": {
      "path": "/api/v1/artworks/",
      "data": "data",
      "fields": "id,title,artist_display,date_display,date_start,image_id,is_public_domain,medium_display,place_of_origin,department_title,description,credit_line,dimensions"
    }
  },
  "fields": {
    "id": "id",
    "title": "title",
    "artist": "artist_display",
    "date": "date_display",
    "year": "date_start",
    "image": "image_id",
    "public": "is_public_domain",
    "medium": "medium_display",
    "place": "place_of_origin",
    "department": "department_title",
    "description": "description",
    "credit": "credit_line",
    "dimensions": "dimensions"
  },
  "links": {
    "item_page": "https://www.artic.edu/artworks/"
  },
  "attribution": {
    "line": "Image and data: Art Institute of Chicago, public domain (CC0)",
    "description_line": "Description: Art Institute of Chicago, CC BY 4.0"
  },
  "tiles": {
    "share_label": "Public domain",
    "peak_label": "Peak period",
    "dept_label": "Top department",
    "pictured_label": "Pictured"
  },
  "charts_note": "none: add a chart view by copying the items view and changing its right_widget in emit_yaml()",
