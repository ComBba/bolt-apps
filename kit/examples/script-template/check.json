{
  "script": "scripts/script-template__app.py",
  "interpreter": "python3",
  "manifest_actions": 2,
  "kit": "scripts/script-template__bolt_app_kit.py",
  "fixture": true,
  "cases": [
    {
      "name": "overview: tiles, a featured artwork, drills, Check again",
      "os": "macos",
      "args": [
        "overview"
      ],
      "golden": "golden/overview.json",
      "expect": {
        "text_present": [
          "Sample data",
          "Shown: 6",
          "Matches: 62,220",
          "Water Lilies"
        ]
      }
    },
    {
      "name": "items: a list, a drill per artwork",
      "os": "macos",
      "args": [
        "items"
      ],
      "golden": "golden/items.json",
      "expect": {
        "text_present": [
          "Water Lilies",
          "Cliff Walk at Pourville"
        ]
      }
    },
    {
      "name": "a search word narrows the list",
      "os": "macos",
      "args": [
        "items",
        "cliff"
      ],
      "expect": {
        "text_present": [
          "Cliff Walk at Pourville"
        ],
        "text_absent": [
          "Water Lilies"
        ]
      }
    },
    {
      "name": "a first word that is not a view is a search word",
      "os": "macos",
      "args": [
        "lilies"
      ],
      "expect": {
        "text_present": [
          "Water Lilies"
        ],
        "text_absent": [
          "Cliff Walk"
        ]
      }
    },
    {
      "name": "no match",
      "os": "macos",
      "args": [
        "items",
        "zzzz"
      ],
      "expect": {
        "text_present": [
          "No match"
        ]
      }
    },
    {
      "name": "a one-letter word asks for a longer one",
      "os": "macos",
      "args": [
        "items",
        "x"
      ],
      "expect": {
        "text_present": [
          "Type a longer word"
        ]
      }
    },
    {
      "name": "detail with Back: picture, description, attribution",
      "os": "macos",
      "args": [
        "item",
        "16568"
      ],
      "golden": "golden/item.json",
      "expect": {
        "text_present": [
          "Back to the list",
          "Water Lilies",
          "CC BY 4.0",
          "Public domain (CC0)"
        ]
      }
    },
    {
      "name": "detail of a listed artwork with no recorded description",
      "os": "macos",
      "args": [
        "item",
        "14598"
      ],
      "expect": {
        "text_present": [
          "The Beach at Sainte-Adresse",
          "Attribution"
        ]
      }
    },
    {
      "name": "unknown id",
      "os": "macos",
      "args": [
        "item",
        "99999"
      ],
      "expect": {
        "text_present": [
          "Not found"
        ]
      }
    },
    {
      "name": "pictures: a card grid",
      "os": "macos",
      "args": [
        "pictures"
      ],
      "golden": "golden/pictures.json",
      "expect": {
        "text_present": [
          "Water Lilies"
        ]
      }
    },
    {
      "name": "grid: a thumbnail grid",
      "os": "macos",
      "args": [
        "grid"
      ],
      "golden": "golden/grid.json",
      "expect": {
        "text_present": [
          "Water Lilies"
        ]
      }
    },
    {
      "name": "offline with nothing cached: one retry row",
      "os": "macos",
      "args": [
        "overview",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not reach Art Institute of Chicago",
          "OFFLINE"
        ]
      }
    },
    {
      "name": "offline with an old copy: the data and a banner",
      "os": "macos",
      "args": [
        "items",
        "demo-stale"
      ],
      "expect": {
        "text_present": [
          "Showing an old copy",
          "Water Lilies"
        ]
      }
    },
    {
      "name": "detail offline: one retry row",
      "os": "macos",
      "args": [
        "item",
        "16568",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not reach Art Institute of Chicago"
        ]
      }
    },
    {
      "name": "hostile text is cleaned",
      "os": "macos",
      "args": [
        "items",
        "{{x}}"
      ],
      "expect": {
        "text_present": [
          "No match"
        ]
      }
    }
  ]
}
