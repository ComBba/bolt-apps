{
  "script": "scripts/script-template__app.py",
  "interpreter": "python3",
  "manifest_actions": 2,
  "kit": "scripts/script-template__bolt_app_kit.py",
  "fixture": true,
  "cases": [
    {
      "name": "overview: four number tiles, drills, Check again",
      "os": "macos",
      "args": [
        "overview"
      ],
      "golden": "golden/overview.json",
      "expect": {
        "text_present": [
          "Public domain: 60%",
          "Peak period: 375 artworks",
          "Top department: Prints and Drawings",
          "Pictured: 9 artworks"
        ]
      }
    },
    {
      "name": "items: a list with a picture and facts in the pane",
      "os": "macos",
      "args": [
        "items"
      ],
      "golden": "golden/items.json",
      "expect": {
        "text_present": [
          "Landscape with Saint John on Patmos",
          "Nicolas Poussin",
          "17th c."
        ]
      }
    },
    {
      "name": "a search word narrows the list",
      "os": "macos",
      "args": [
        "items",
        "poussin"
      ],
      "expect": {
        "text_present": [
          "Landscape with Saint John on Patmos"
        ],
        "text_absent": [
          "Kandinsky"
        ]
      }
    },
    {
      "name": "two search words",
      "os": "macos",
      "args": [
        "items",
        "two",
        "poplars"
      ],
      "expect": {
        "text_present": [
          "Landscape with Two Poplars"
        ],
        "text_absent": [
          "Poussin"
        ]
      }
    },
    {
      "name": "a first word that is not a view is a search word",
      "os": "macos",
      "args": [
        "kandinsky"
      ],
      "expect": {
        "text_present": [
          "Landscape with Two Poplars"
        ],
        "text_absent": [
          "Poussin"
        ]
      }
    },
    {
      "name": "no match",
      "os": "macos",
      "args": [
        "items",
        "zzzz"
      ],
      "expect": {
        "text_present": [
          "No match"
        ]
      }
    },
    {
      "name": "a one-letter word asks for a longer one",
      "os": "macos",
      "args": [
        "items",
        "x"
      ],
      "expect": {
        "text_present": [
          "Type a longer word"
        ]
      }
    },
    {
      "name": "detail with Back: picture, description, attribution",
      "os": "macos",
      "args": [
        "item",
        "5848"
      ],
      "golden": "golden/item.json",
      "expect": {
        "text_present": [
          "Back to the list",
          "Landscape with Saint John on Patmos",
          "Record (JSON)",
          "Attribution"
        ]
      }
    },
    {
      "name": "detail of a listed artwork with no recorded description",
      "os": "macos",
      "args": [
        "item",
        "874"
      ],
      "expect": {
        "text_present": [
          "Landscape",
          "Attribution"
        ]
      }
    },
    {
      "name": "record: the fields as a tree",
      "os": "macos",
      "args": [
        "record",
        "5848"
      ],
      "expect": {
        "text_present": [
          "Record 5848",
          "Back to the artwork"
        ]
      }
    },
    {
      "name": "unknown id",
      "os": "macos",
      "args": [
        "item",
        "99999"
      ],
      "expect": {
        "text_present": [
          "Not found"
        ]
      }
    },
    {
      "name": "pictures: a card grid",
      "os": "macos",
      "args": [
        "pictures"
      ],
      "golden": "golden/pictures.json",
      "expect": {
        "text_present": [
          "Landscape with Saint John on Patmos",
          "sample data"
        ]
      }
    },
    {
      "name": "chart: artworks per period",
      "os": "macos",
      "args": [
        "chart"
      ],
      "golden": "golden/chart.json",
      "expect": {
        "text_present": [
          "Before 1600",
          "1600 to 1700",
          "375 public-domain artworks",
          "sample data"
        ]
      }
    },
    {
      "name": "table: departments with shares",
      "os": "macos",
      "args": [
        "table"
      ],
      "golden": "golden/table.json",
      "expect": {
        "text_present": [
          "Prints and Drawings",
          "894 artworks, 81%",
          "Other departments",
          "sample data"
        ]
      }
    },
    {
      "name": "offline with nothing cached: one retry row",
      "os": "macos",
      "args": [
        "overview",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not reach Art Institute of Chicago",
          "OFFLINE"
        ]
      }
    },
    {
      "name": "offline with an old copy: the data and a label",
      "os": "macos",
      "args": [
        "items",
        "demo-stale"
      ],
      "expect": {
        "text_present": [
          "Showing an old copy",
          "Landscape with Saint John on Patmos"
        ]
      }
    },
    {
      "name": "an old copy of the table says so on its first row",
      "os": "macos",
      "args": [
        "table",
        "demo-stale"
      ],
      "expect": {
        "text_present": [
          "old copy",
          "Prints and Drawings"
        ]
      }
    },
    {
      "name": "detail offline: one retry row",
      "os": "macos",
      "args": [
        "item",
        "5848",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not reach Art Institute of Chicago"
        ]
      }
    },
    {
      "name": "hostile text is cleaned",
      "os": "macos",
      "args": [
        "items",
        "{{x}}"
      ],
      "expect": {
        "text_present": [
          "No match"
        ]
      }
    }
  ]
}
