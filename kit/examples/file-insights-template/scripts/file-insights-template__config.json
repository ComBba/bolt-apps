{
  "app": {
    "id": "file-insights-template",
    "chip": "file-insights-template",
    "title": "File insights",
    "icon": "line-chart",
    "description": "Type a path to a CSV file: totals, trend, breakdown and what to watch. Read-only, local. No path shows labelled sample data.",
    "timeout": 20
  },
  "limits": {
    "max_bytes": 5000000,
    "max_rows": 5000,
    "max_cols": 40,
    "max_cell": 200,
    "max_points": 40,
    "preview_rows": 25
  },
  "delimiters": [",", ";", "\t", "|"],
  "columns": {
    "date": ["date", "day", "month", "order date", "timestamp", "created", "period"],
    "value": ["amount", "total", "revenue", "sales", "value", "price", "cost", "qty", "quantity"],
    "category": ["category", "type", "region", "product", "name", "customer", "channel", "segment"]
  },
  "mapping": {},
  "date_formats": ["%Y-%m-%d", "%Y/%m/%d", "%m/%d/%Y", "%d.%m.%Y", "%Y-%m"],
  "currency": "$€£¥₹",
  "unit": "",
  "rules": [
    {"id": "total", "kind": "sum", "title": "Total {total}", "subtitle": "{n} rows, mean {mean} per row"},
    {"id": "change", "kind": "change", "watch_below_pct": -10, "good_above_pct": 5, "title": "Latest period {change}", "subtitle": "{last_label} against {prev_label}"},
    {"id": "concentration", "kind": "top_share", "watch_above_pct": 50, "title": "{top} is {share}% of the total", "subtitle": "largest of {groups} groups"},
    {"id": "outliers", "kind": "outliers", "z": 3, "title": "{count} unusual values", "subtitle": "more than 3 standard deviations from the mean"},
    {"id": "gaps", "kind": "missing", "watch_above_pct": 5, "title": "{pct}% of rows skipped", "subtitle": "empty or not a number in the value column"}
  ],
  "charts": {
    "trend": {"title": "Total per period", "type": "line"},
    "breakdown": {"title": "Total by group, top 10", "type": "bar"}
  },
  "table_columns": [
    {"field": "date", "label": "Date"},
    {"field": "category", "label": "Group"},
    {"field": "value", "label": "Value", "align": "right", "total": "sum"}
  ]
}
