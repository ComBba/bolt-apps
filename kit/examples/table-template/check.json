{
  "script": "scripts/table-template__engine.py",
  "interpreter": "python3",
  "manifest_actions": 2,
  "kit": "scripts/table-template__bolt_app_kit.py",
  "fixture": true,
  "cases": [
    {
      "name": "overview",
      "os": "macos",
      "args": [
        "overview"
      ],
      "golden": "golden/overview.json"
    },
    {
      "name": "orders: only data rows, numbers stay numbers",
      "os": "macos",
      "args": [
        "orders"
      ],
      "golden": "golden/orders.json",
      "expect": {
        "text_absent": [
          "Back"
        ]
      }
    },
    {
      "name": "share table",
      "os": "macos",
      "args": [
        "shares"
      ],
      "golden": "golden/shares.json"
    },
    {
      "name": "stale preview",
      "os": "macos",
      "args": [
        "orders",
        "demo-stale"
      ],
      "expect": {
        "text_present": [
          "STALE"
        ]
      }
    },
    {
      "name": "no key and no sample switch: the labelled sample data is shown, with a SAMPLE DATA row and a key hint (api.on_missing_key sample)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "overview"
      ],
      "expect": {
        "text_present": [
          "SAMPLE DATA: add your Table template API key to see live data",
          "Add your Table template API key"
        ]
      }
    }
  ]
}
