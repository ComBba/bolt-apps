{
  "script": "scripts/app.py",
  "interpreter": "python3",
  "manifest_actions": 2,
  "kit": "scripts/bolt_app_kit.py",
  "cases": [
    {
      "name": "trending: tile row and stories",
      "os": "macos",
      "args": [
        "overview"
      ],
      "golden": "golden/overview.json",
      "expect": {
        "text_present": [
          "Trending: 30 stories",
          "A small database that fits in a single file",
          "Sample data"
        ],
        "text_absent": [
          "Unused story beyond the first thirty"
        ]
      }
    },
    {
      "name": "a bare word is a topic: two sources merged",
      "os": "macos",
      "args": [
        "rust"
      ],
      "golden": "golden/topic-rust.json",
      "expect": {
        "text_present": [
          "Topic rust: 7 stories",
          "Rust 2.0 release notes",
          "Rust ownership explained with pictures",
          "BOTH",
          "Back to trending"
        ],
        "text_absent": [
          "Why our team moved back to a monolith"
        ]
      }
    },
    {
      "name": "topic through the nav view",
      "os": "macos",
      "args": [
        "topic",
        "rust"
      ],
      "expect": {
        "text_present": [
          "Topic rust: 7 stories"
        ]
      }
    },
    {
      "name": "a topic with no match",
      "os": "macos",
      "args": [
        "zzzz"
      ],
      "golden": "golden/topic-none.json",
      "expect": {
        "text_present": [
          "Topic zzzz: 0 stories",
          "No story matches zzzz"
        ]
      }
    },
    {
      "name": "a word that is not one plain word",
      "os": "macos",
      "args": [
        "{{x}}"
      ],
      "expect": {
        "text_present": [
          "Use one plain word"
        ]
      }
    },
    {
      "name": "offline with nothing cached: one retry row",
      "os": "macos",
      "args": [
        "overview",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not reach Hacker News",
          "OFFLINE"
        ],
        "text_absent": [
          "Trending:"
        ]
      }
    },
    {
      "name": "offline with an old copy: the data and a banner",
      "os": "macos",
      "args": [
        "overview",
        "demo-stale"
      ],
      "expect": {
        "text_present": [
          "Showing an old copy",
          "Trending: 30 stories"
        ]
      }
    }
  ],
  "fixture": true
}
