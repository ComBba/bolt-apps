{
  "app": {
    "id": "cli-wrapper-template",
    "chip": "cli-wrapper-template",
    "title": "Ping check",
    "icon": "network",
    "description": "Type a host name: is it reachable, how fast, how much is lost. Wraps the system ping command, read-only.",
    "timeout": 20
  },
  "tool": {
    "name": "ping",
    "install_hint": {
      "macos": "ping ships with macOS. If it is missing, the system tools are damaged: reinstall the Command Line Tools",
      "linux": "Install it with your package manager, for example: sudo apt install iputils-ping"
    }
  },
  "params": {
    "count": {
      "default": 3,
      "min": 1,
      "max": 10
    },
    "wait_s": {
      "default": 5
    }
  },
  "host": {
    "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?|[0-9A-Fa-f:]{2,45})$",
    "max_len": 253
  },
  "commands": {
    "macos": [
      "ping",
      "-c",
      "{count}",
      "-t",
      "{wait}",
      "{host}"
    ],
    "linux": [
      "ping",
      "-c",
      "{count}",
      "-w",
      "{wait}",
      "{host}"
    ]
  },
  "exit_codes": {
    "macos": {
      "0": "ok",
      "2": "no reply",
      "68": "unknown host"
    },
    "linux": {
      "0": "ok",
      "1": "no reply",
      "2": "unknown host or no network"
    }
  },
  "limits": {
    "command_timeout": 8,
    "max_output": 20000,
    "result_ttl": 120
  },
  "parse": {
    "macos": {
      "reply": "icmp_seq=(\\d+) .*?time=([0-9.]+) ms",
      "sent": "(\\d+) packets transmitted",
      "received": "(\\d+) packets received",
      "loss": "([0-9.]+)% packet loss",
      "rtt": "= ([0-9.]+)/([0-9.]+)/([0-9.]+)/"
    },
    "linux": {
      "reply": "icmp_seq=(\\d+) .*?time=([0-9.]+) ms",
      "sent": "(\\d+) packets transmitted",
      "received": "(\\d+) received",
      "loss": "([0-9.]+)% packet loss",
      "rtt": "= ([0-9.]+)/([0-9.]+)/([0-9.]+)/"
    }
  },
  "verdict": {
    "degraded_loss_pct": 10,
    "slow_avg_ms": 150
  },
  "chart": {
    "title": "Round trip per reply, ms",
    "type": "line"
  }
}