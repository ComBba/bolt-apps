{
  "app": {
    "id": "branch-explorer",
    "chip": "branch-explorer",
    "title": "Branch explorer",
    "icon": "GitMerge",
    "description": "Walk a tree one level at a time: Enter on a branch goes in, Back comes out. Invented sample data.",
    "service": "Branch explorer",
    "searchable": true
  },
  "api": {
    "base_url": "https://api.example.com",
    "key_env": "BRANCH_API_KEY",
    "env_file": "~/.config/branch-explorer/.env",
    "fixture_default": false,
    "fixture_file": "fixtures.json",
    "fixture_banner": false
  },
  "cache": {
    "ttl": 45,
    "stale_max": 86400
  },
  "endpoints": {
    "nodes": {
      "path": "/v1/nodes",
      "map": {
        "title": "name"
      }
    }
  },
  "stats": {
    "nodes_total": {
      "endpoint": "nodes"
    }
  },
  "overview": {
    "rows": [
      {
        "title": "Start at the root",
        "subtitle": "Enter goes into the first branch",
        "icon": "GitMerge",
        "view": "node",
        "arg": "root",
        "tile": {
          "label": "Nodes",
          "value": "nodes_total",
          "note": "in the whole tree"
        }
      }
    ]
  },
  "views": [
    {
      "id": "node",
      "title": "Branch",
      "icon": "GitMerge",
      "endpoint": "nodes",
      "children": [
        {
          "view": "node",
          "match": "parent"
        }
      ],
      "no_children": "A leaf: nothing below",
      "item": {
        "title": "{title}",
        "subtitle": "{kind} · {note}",
        "icon": "GitMerge",
        "body": "## {title}\n\n{note}",
        "fields": [
          {
            "label": "Kind",
            "value": "{kind}"
          },
          {
            "label": "Level",
            "value": "{level}"
          },
          {
            "label": "Path",
            "value": "{path}"
          }
        ]
      }
    }
  ]
}
