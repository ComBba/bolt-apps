      "limits": "personal pack only; per-OS command table; stderr is not seen; 60 s at most"
    },
    {
      "backs": "remote HTTP API",
      "runtime": "bridge",
      "how": "a script calls the API (urllib) inside a deadline; keys from keychain or ~/.config/<app>/.env",
      "use": "repo-radar, around (several APIs joined); lookup-template, chart-template, table-template, portal-template (one API, config only)",
      "limits": "declare network; a shell variable never reaches the script"
    },
    {
      "backs": "local HTTP service",
      "runtime": "http_local",
      "how": "Bolt makes one GET or POST to 127.0.0.1, localhost or ::1; no script",
      "use": "local-service-template",
      "limits": "loopback only, one request, no secrets, no chaining"
    },
    {
      "backs": "file",
      "runtime": "bridge",
      "how": "a script reads a path the person types, with caps and a regular-file check",
      "use": "file-insights-template (read), form-template (write its own log)",
      "limits": "declare files; the path travels as query words, not in a nav arg"
    },
    {
      "backs": "MCP server",
      "runtime": "none native",
      "how": "a bridge script starts the MCP server over stdio and calls one tool (see ENGINE.md, MCP workaround)",
