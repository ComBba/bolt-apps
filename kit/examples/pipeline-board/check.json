{
  "script": "scripts/pipeline-board__engine.py",
  "interpreter": "python3",
  "manifest_actions": 2,
  "kit": "scripts/pipeline-board__bolt_app_kit.py",
  "fixture": true,
  "cases": [
    {
      "name": "overview: three drills",
      "os": "macos",
      "args": [
        "overview"
      ],
      "golden": "golden/overview.json",
      "expect": {
        "text_present": [
          "Stages",
          "FAILURES",
          "What changed"
        ]
      }
    },
    {
      "name": "a stage drills to its runs",
      "os": "macos",
      "args": [
        "stages",
        "build"
      ],
      "golden": "golden/stages-build.json",
      "expect": {
        "text_present": [
          "Back to stages",
          "Run 302",
          "Run 303"
        ],
        "text_absent": [
          "Run 306"
        ]
      }
    },
    {
      "name": "runs, failed first",
      "os": "macos",
      "args": [
        "runs"
      ],
      "golden": "golden/runs.json",
      "expect": {
        "text_present": [
          "6 runs",
          "Run 303"
        ]
      }
    },
    {
      "name": "the diff list",
      "os": "macos",
      "args": [
        "changes"
      ],
      "golden": "golden/changes.json",
      "expect": {
        "text_present": [
          "login form, line 12",
          "readme intro"
        ]
      }
    },
    {
      "name": "offline with nothing cached",
      "os": "macos",
      "args": [
        "runs",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not connect"
        ]
      }
    },
    {
      "name": "no key and no sample switch: the sample data is shown, with the sample label and a key hint on a tile (api.on_missing_key sample)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "overview"
      ],
      "expect": {
        "text_present": [
          "sample data"
        ]
      }
    },
    {
      "name": "sample label is visible in the stages view (no key)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "stages"
      ],
      "expect": {}
    },
    {
      "name": "sample label is visible in the runs view (no key)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "runs"
      ],
      "expect": {}
    },
    {
      "name": "sample label is visible in the changes view (no key)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "changes"
      ],
      "expect": {}
    }
  ]
}
