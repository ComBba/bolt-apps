{
 "mode": "lookup",
 "maps": {
  "wmo": {
   "0": "Clear",
   "1": "Mostly clear",
   "2": "Partly cloudy",
   "3": "Overcast",
   "45": "Fog",
   "48": "Rime fog",
   "51": "Light drizzle",
   "53": "Drizzle",
   "55": "Heavy drizzle",
   "61": "Light rain",
   "63": "Rain",
   "65": "Heavy rain",
   "71": "Light snow",
   "73": "Snow",
   "75": "Heavy snow",
   "80": "Rain showers",
   "81": "Rain showers",
   "82": "Violent showers",
   "95": "Thunderstorm",
   "96": "Thunderstorm, hail",
   "99": "Thunderstorm, hail"
  }
 },
 "app": {
  "id": "lookup-template",
  "chip": "forecast",
  "title": "Forecast lookup",
  "icon": "cloud-sun",
  "description": "Type a place, get its weather. One query in, tiles and rows out, from two keyless Open-Meteo calls.",
  "service": "Open-Meteo",
  "timeout": 20
 },
 "api": {
  "base_url": "https://api.open-meteo.com",
  "user_agent": "bolt-app-example/1.0 (lookup-template)",
  "fixture_default": true,
  "fixture_file": "fixtures.json",
  "fixture_banner": true,
  "allowed_hosts": [
   "geocoding-api.open-meteo.com"
  ]
 },
 "cache": {
  "ttl": 900,
  "stale_max": 86400
 },
 "endpoints": {
  "geocode": {
   "path": "https://geocoding-api.open-meteo.com/v1/search?name={query}&count=1&language=en&format=json",
   "data": "results"
  },
  "weather": {
   "path": "/v1/forecast?latitude={geocode.latitude}&longitude={geocode.longitude}&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code,precipitation&hourly=temperature_2m&daily=temperature_2m_max,temperature_2m_min,sunrise,sunset,weather_code,precipitation_probability_max&timezone=auto&forecast_days=3",
   "kind": "object",
   "data": "",
   "require": [
    "current"
   ]
  }
 },
 "lookup": {
  "steps": [
   "geocode",
   "weather"
  ],
  "prompt_title": "Type a place",
  "prompt_subtitle": "for example: =forecast New York",
  "none_title": "No such place",
  "examples": [
   "New York",
   "Paris",
   "Tokyo"
  ],
  "rows": [
   {
    "title": "{geocode.name} \u00b7 {weather.current.temperature_2m}\u00b0C, {weather.current.weather_code|wmo}",
    "subtitle": "feels like {weather.current.apparent_temperature}\u00b0C \u00b7 humidity {weather.current.relative_humidity_2m}% \u00b7 local time {weather.current.time|hhmm}",
    "icon": "cloud-sun",
    "url": "https://www.openstreetmap.org/?mlat={geocode.latitude}&mlon={geocode.longitude}#map=11/{geocode.latitude}/{geocode.longitude}",
    "trend_path": "weather.hourly.temperature_2m",
    "tile": {
     "label": "Temperature",
     "value": "weather.current.temperature_2m",
     "unit": "\u00b0C",
     "note": "next 24 hours below",
     "foot": "{geocode.admin1}, {geocode.country}",
     "badge": "NOW"
    }
   },
   {
    "title": "Feels like {weather.current.apparent_temperature}\u00b0C",
    "subtitle": "wind {weather.current.wind_speed_10m} km/h \u00b7 rain now {weather.current.precipitation} mm",
    "icon": "cloud-sun",
    "tile": {
     "label": "Feels like",
     "value": "weather.current.apparent_temperature",
     "unit": "\u00b0C"
    }
   },
   {
    "title": "Humidity {weather.current.relative_humidity_2m}%",
    "subtitle": "relative humidity",
    "icon": "activity",
    "tile": {
     "label": "Humidity",
     "value": "weather.current.relative_humidity_2m",
     "max": 100,
     "unit": "%"
    }
   },
   {
    "title": "Wind {weather.current.wind_speed_10m} km/h",
    "subtitle": "at 10 m",
    "icon": "wifi",
    "tile": {
     "label": "Wind",
     "value": "weather.current.wind_speed_10m",
     "unit": "km/h"
    }
   },
   {
    "title": "{weather.daily.time.0|day} \u00b7 high {weather.daily.temperature_2m_max.0}\u00b0C, low {weather.daily.temperature_2m_min.0}\u00b0C",
    "subtitle": "{weather.daily.weather_code.0|wmo} \u00b7 rain chance {weather.daily.precipitation_probability_max.0}% \u00b7 sun {weather.daily.sunrise.0|hhmm} to {weather.daily.sunset.0|hhmm}",
    "icon": "cloud-sun",
    "tile": {
     "label": "Today",
     "value": "weather.daily.temperature_2m_max.0",
     "unit": "\u00b0C",
     "note": "high, low {weather.daily.temperature_2m_min.0}\u00b0C",
     "foot": "{weather.daily.weather_code.0|wmo}"
    }
   },
   {
    "title": "{weather.daily.time.1|day} \u00b7 high {weather.daily.temperature_2m_max.1}\u00b0C, low {weather.daily.temperature_2m_min.1}\u00b0C",
    "subtitle": "{weather.daily.weather_code.1|wmo} \u00b7 rain chance {weather.daily.precipitation_probability_max.1}% \u00b7 sun {weather.daily.sunrise.1|hhmm} to {weather.daily.sunset.1|hhmm}",
    "icon": "cloud-sun",
    "tile": {
     "label": "Tomorrow",
     "value": "weather.daily.temperature_2m_max.1",
     "unit": "\u00b0C",
     "note": "high, low {weather.daily.temperature_2m_min.1}\u00b0C",
     "foot": "{weather.daily.weather_code.1|wmo}"
    }
   },
   {
    "title": "{weather.daily.time.2|day} \u00b7 high {weather.daily.temperature_2m_max.2}\u00b0C, low {weather.daily.temperature_2m_min.2}\u00b0C",
    "subtitle": "{weather.daily.weather_code.2|wmo} \u00b7 rain chance {weather.daily.precipitation_probability_max.2}% \u00b7 sun {weather.daily.sunrise.2|hhmm} to {weather.daily.sunset.2|hhmm}",
    "icon": "cloud-sun",
    "tile": {
     "label": "Day 3",
     "value": "weather.daily.temperature_2m_max.2",
     "unit": "\u00b0C",
     "note": "high, low {weather.daily.temperature_2m_min.2}\u00b0C",
     "foot": "{weather.daily.weather_code.2|wmo}"
    }
   },
   {
    "title": "Coordinates",
    "subtitle": "{geocode.latitude}, {geocode.longitude} \u00b7 {geocode.timezone}",
    "icon": "map-pin",
    "url": "https://www.openstreetmap.org/?mlat={geocode.latitude}&mlon={geocode.longitude}#map=11/{geocode.latitude}/{geocode.longitude}"
   },
   {
    "title": "Open the full forecast",
    "subtitle": "open-meteo.com",
    "icon": "globe",
    "url": "https://open-meteo.com/en/docs#latitude={geocode.latitude}&longitude={geocode.longitude}"
   }
  ],
  "widget": {
   "kind": "cards",
   "mode": "list_data",
   "bind": {
    "layout": "tiles",
    "title": "{{row.kpi_label}}",
    "value": "{{row.kpi_value}}",
    "unit": "{{row.kpi_unit}}",
    "max": "{{row.kpi_max}}",
    "trend": "{{row.trend}}",
    "subtitle": "{{row.kpi_note}}",
    "badge": "{{row.kpi_badge}}",
    "footer": "{{row.kpi_foot}}"
   }
  }
 }
}