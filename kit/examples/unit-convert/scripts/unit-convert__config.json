{
  "app": {
    "id": "unit-convert",
    "chip": "convert",
    "title": "Unit convert",
    "icon": "arrow-left-right",
    "description": "Type an amount, pick two units, get the result with the formula and the same amount in the other units of that kind. Offline, no network."
  },
  "default_from": "km",
  "default_to": "mi",
  "units": {
    "length": { "mm": 0.001, "cm": 0.01, "m": 1, "km": 1000, "in": 0.0254, "ft": 0.3048, "yd": 0.9144, "mi": 1609.344 },
    "mass": { "g": 0.001, "kg": 1, "oz": 0.028349523125, "lb": 0.45359237 },
    "temperature": { "C": null, "F": null, "K": null }
  },
  "temperature_formulas": {
    "C>F": "F = C x 9 / 5 + 32",
    "F>C": "C = (F - 32) x 5 / 9",
    "C>K": "K = C + 273.15",
    "K>C": "C = K - 273.15",
    "F>K": "K = (F - 32) x 5 / 9 + 273.15",
    "K>F": "F = (K - 273.15) x 9 / 5 + 32"
  }
}
