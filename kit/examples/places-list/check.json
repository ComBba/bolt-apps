{
  "script": "scripts/places-list__engine.py",
  "interpreter": "python3",
  "manifest_actions": 2,
  "kit": "scripts/places-list__bolt_app_kit.py",
  "fixture": true,
  "cases": [
    {
      "name": "overview: open now tile",
      "os": "macos",
      "args": [
        "overview"
      ],
      "golden": "golden/overview.json",
      "expect": {
        "text_present": [
          "Nearby places",
          "SOME OPEN"
        ]
      }
    },
    {
      "name": "places nearest first",
      "os": "macos",
      "args": [
        "places"
      ],
      "golden": "golden/places.json",
      "expect": {
        "text_present": [
          "5 places",
          "Riverside Cafe",
          "Harbour Lights Bistro"
        ]
      }
    },
    {
      "name": "filter word",
      "os": "macos",
      "args": [
        "places",
        "bakery"
      ],
      "expect": {
        "text_present": [
          "Old Market Bakery"
        ],
        "text_absent": [
          "Riverside Cafe"
        ]
      }
    },
    {
      "name": "offline with nothing cached",
      "os": "macos",
      "args": [
        "places",
        "demo-offline"
      ],
      "expect": {
        "text_present": [
          "Could not connect"
        ]
      }
    },
    {
      "name": "no key and no sample switch: the sample data is shown, with the sample label and a key hint on a tile (api.on_missing_key sample)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "overview"
      ],
      "expect": {
        "text_present": [
          "sample data: add your Places list API key for live data"
        ]
      }
    },
    {
      "name": "sample label is visible in the places view (no key)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "places"
      ],
      "expect": {}
    }
  ]
}
